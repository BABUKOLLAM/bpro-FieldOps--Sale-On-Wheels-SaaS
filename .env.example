# ---- Per-client deployment configuration ----
# Copy to .env and fill in for each client instance. This file is the
# single source of truth for what differs between one client's deployment
# and another (see docs/PROVISIONING.md).

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-generate-a-real-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Company identity for this deployment
COMPANY_NAME=Demo Distributors Pvt Ltd

# Postgres
POSTGRES_DB=vansales
POSTGRES_USER=vansales
POSTGRES_PASSWORD=vansales
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=14

# Field-level encryption key for stored ERP connector credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# Connector agent (on-prem Tally connector authenticates with this key)
CONNECTOR_API_KEY=change-me-connector-key

# Admin web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
