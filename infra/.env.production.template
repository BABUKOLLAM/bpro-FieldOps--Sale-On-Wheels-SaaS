# ======================================================================
# PRODUCTION DEPLOYMENT CONFIGURATION FOR A DEDICATED VPS
# ======================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to infra/.env (git-ignored)
# 2. Replace all "change-me-*" values with production secrets
# 3. Never commit this file to git
# 4. Use strong passwords (20+ chars) and unique tokens
# 5. Verify all domains/URLs match your production setup
# 6. Run: cd infra && bash deploy.sh (from this directory)
#
# SECURITY REMINDERS:
# - Store backups of SECRET_KEY and FIELD_ENCRYPTION_KEY safely
# - POSTGRES_PASSWORD must be 20+ chars, alphanumeric + special chars
# - CONNECTOR_API_KEY is used by on-prem agents — keep it secure
# - SSH into VPS and verify .env permissions: chmod 600 .env
# ======================================================================

# ---- Django Configuration ----
DJANGO_SETTINGS_MODULE=config.settings.production

# SECRET_KEY: Django secret for signing cookies, sessions, tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# This is CRITICAL for security — generate a new one, don't reuse
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50

# DEBUG=0 in production (NEVER set to 1 — exposes sensitive data)
DEBUG=0

# API domain(s) that Django will accept. Include:
# - Your public API domain (e.g., api.fieldopspro.in)
# - The internal Docker network hostname "backend" (for admin-web proxy calls)
# Example: ALLOWED_HOSTS=api.fieldopspro.in,backend
ALLOWED_HOSTS=api.fieldopspro.in,backend

# CORS Origins: domains that can call the API from a browser
# Include all frontend domains (https only in production)
# Example: CORS_ALLOWED_ORIGINS=https://www.fieldopspro.in
CORS_ALLOWED_ORIGINS=https://www.fieldopspro.in

# FRONTEND_BASE_URL: Used for building email links (e.g., password reset URLs)
# Should be the primary production domain
FRONTEND_BASE_URL=https://www.fieldopspro.in

# ---- Company Identity ----
# Company name used in UI, emails, reports
COMPANY_NAME=Your Company Name Pvt Ltd

# ---- PostgreSQL Database ----
POSTGRES_IMAGE=postgres:15@sha256:REPLACE_WITH_VERIFIED_DIGEST
# POSTGRES_PASSWORD: 20+ chars, mix upper/lower/numbers/symbols (e.g., Tr0p1cal!Qu@st_2024)
# DO NOT use simple passwords — this is a critical security boundary
POSTGRES_DB=vansales
POSTGRES_USER=vansales
POSTGRES_PASSWORD=change-me-strong-password-20plus-chars

# Container network (keep as-is; only override if using external Postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_IMAGE=redis:7@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Redis is used for caching, sessions, Celery task queue
# Keep default if using Docker Compose, or update if using external Redis
REDIS_URL=redis://redis:6379/0

# ---- JWT Token Lifetimes ----
# How long access tokens remain valid before requiring a refresh
ACCESS_TOKEN_LIFETIME_MINUTES=15

# How long refresh tokens remain valid (user can get new access tokens)
REFRESH_TOKEN_LIFETIME_DAYS=14

# ---- Field-Level Encryption ----
# Encrypts ERP connector credentials (Tally API keys, etc.) at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Store this backup securely; losing it means encrypted data becomes unrecoverable
FIELD_ENCRYPTION_KEY=change-me-fernet-key-generated-with-cryptography

# ---- Connector Agent Authentication ----
# On-prem Tally connector authenticates with this API key
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_API_KEY=change-me-connector-api-key

# Connector requests are HMAC-signed for replay protection
# Set to 0 in production (unsigned requests rejected)
# Only set to 1 if an already-deployed agent binary predates signing
CONNECTOR_ALLOW_UNSIGNED=0

# ---- Admin Web (Frontend) ----
# The API's public domain (baked into the admin-web build during docker-compose build)
# Must match the backend ALLOWED_HOSTS domain
NEXT_PUBLIC_API_BASE_URL=https://api.fieldopspro.in
NGINX_IMAGE=nginx:1.27-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
CERTBOT_IMAGE=certbot/certbot@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Auth cookie domain scope for single sign-on across subdomains
# ".fieldopspro.in" = login once across the configured fieldopspro.in hosts
# Leave blank for host-only cookies (each domain has separate sessions)
AUTH_COOKIE_DOMAIN=.fieldopspro.in

# ---- Optional: Error Tracking (Sentry) ----
# Set to your Sentry DSN to enable error tracking
# Format: https://key@sentry.example.com/123
# Leave blank to skip Sentry (errors logged to console/Docker logs only)
SENTRY_DSN=

# ---- Optional: Outbound Email ----
# Used for password resets, report delivery, notifications
# If left blank, emails are logged to console (safe for development, not production)
# Examples:
#   Gmail: smtp.gmail.com, port 587
#   AWS SES: email-smtp.<region>.amazonaws.com, port 587
#   Custom: your-mail-server.com, port 25/587/465
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@fieldopspro.in

# ---- Optional: Push Notifications (FCM) ----
# Firebase Cloud Messaging for mobile push notifications (FR-18)
# Leave blank to disable (notifications logged to console)
# Get from Firebase Console > Project Settings > Service Accounts > Private Key
FCM_SERVER_KEY=

# ---- Optional: SMS Gateway ----
# For OTP delivery (FR-12), password resets, alerts
# Leave blank to disable SMS (OTPs logged to console, never sent)
# Examples: Twilio, AWS SNS, custom SMPP gateway
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# ---- Optional: Vault Integration ----
# If using HashiCorp Vault for secret management:
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN=s.xxxxx (or use VAULT_ROLE_ID/VAULT_SECRET_ID for AppRole)
# Leave blank to use environment variables / Docker secrets instead
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ---- Optional: Multi-Tenant SaaS Mode ----
# If moving to multi-tenant SaaS (subdomain-per-tenant routing):
# PLATFORM_ROOT_DOMAINS=fieldopspro.in
# Leave unset for single-client deployment (current mode)
# PLATFORM_ROOT_DOMAINS=

# ======================================================================
# DEPLOYMENT CHECKLIST
# ======================================================================
# Before running deploy.sh, verify:
#
# □ SECRET_KEY is a new, random token (20+ chars, alphanumeric + symbols)
# □ POSTGRES_PASSWORD is 20+ chars with mixed case, numbers, symbols
# □ FIELD_ENCRYPTION_KEY generated with cryptography.fernet.Fernet
# □ CONNECTOR_API_KEY is a random token (32+ chars)
# □ All ALLOWED_HOSTS domains are correct
# □ CORS_ALLOWED_ORIGINS matches frontend domains (HTTPS only)
# □ FRONTEND_BASE_URL is the primary production domain
# □ NEXT_PUBLIC_API_BASE_URL matches backend API domain
# □ EMAIL settings configured OR left blank (don't test SMTP in .env)
# □ Backup SECRET_KEY and FIELD_ENCRYPTION_KEY securely
# □ No secrets stored in git (use .env with chmod 600)
# □ SSH keys configured for VPS deploy (if using auto-deploy)
# □ Optional services (Sentry, Vault, FCM) configured if needed
#
# AFTER DEPLOYMENT:
# 1. SSH into VPS and verify: chmod 600 infra/.env
# 2. Test health endpoint: curl https://api.<your-domain>/healthz/
# 3. Check logs: docker compose logs -f backend
# 4. Verify admin-web loads: https://www.fieldopspro.in
# 5. Create first superuser: docker compose exec backend python manage.py createsuperuser
# 6. Test login at: https://www.fieldopspro.in
# ======================================================================
