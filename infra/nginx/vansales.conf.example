# Production nginx config for a single-client deployment — two public
# hostnames sharing one Let's Encrypt certificate (issued with both as
# Subject Alternative Names, see docs/DEPLOYMENT.md step 6):
#   app.fieldopspro.in  -> admin-web (Next.js) — the back-office console
#   api.fieldopspro.in  -> backend (Django)    — hit directly by the
#                                                 mobile app; admin-web's
#                                                 own server-side proxy
#                                                 talks to `backend:8000`
#                                                 over the compose network
#                                                 instead, never through
#                                                 this domain.
#
# Copy to nginx/vansales.conf as-is — the domain (fieldopspro.in) is
# already filled in. See docs/DEPLOYMENT.md.

server {
    listen 80;
    server_name app.fieldopspro.in api.fieldopspro.in;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.fieldopspro.in;

    ssl_certificate     /etc/letsencrypt/live/app.fieldopspro.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.fieldopspro.in/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Next.js doesn't emit these itself — set them at the edge. `always`
    # so they're present on error responses too.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Signature images / logo uploads go through admin-web's proxy route.
    client_max_body_size 15m;

    location / {
        proxy_pass http://admin-web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.fieldopspro.in;

    ssl_certificate     /etc/letsencrypt/live/app.fieldopspro.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.fieldopspro.in/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Django sets security headers on its own (proxied) responses, but
    # /static/ and /media/ below are served directly by nginx and would
    # otherwise ship with none.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Direct invoice/signature/logo uploads from the mobile app and
    # Django admin.
    client_max_body_size 15m;

    # Served directly off the shared volume instead of proxied through
    # gunicorn — faster, and means WhiteNoise (configured in
    # config/settings/production.py as a fallback) never has to run.
    location /static/ {
        alias /var/www/static/;
    }

    location /media/ {
        alias /var/www/media/;
    }

    location / {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
