# ---- Production deployment configuration (single client) ----
# Copy to infra/.env — next to docker-compose.prod.yml, NOT the repo
# root (that's where the dev .env goes; production keeps its own
# because Docker Compose auto-discovers .env relative to whichever
# compose file's directory you run from, and this avoids needing extra
# --env-file flags on every command). Fill in this client's real
# domain/secrets before running docker-compose.prod.yml — see
# docs/DEPLOYMENT.md.

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-secret
DEBUG=0
# The API's own public domain, plus "backend" — admin-web's server-side
# proxy calls the backend container by that Docker-network hostname, and
# Django's ALLOWED_HOSTS validates that Host header too, not just the
# public one.
ALLOWED_HOSTS=api.fieldopspro.in,backend
CORS_ALLOWED_ORIGINS=https://www.fieldopspro.in
# admin-web's public origin, for building links sent by email (e.g. the
# signup-approval set-password link) — the primary domain from the list
# above, not the API's own domain.
FRONTEND_BASE_URL=https://www.fieldopspro.in

# Company identity for this deployment
COMPANY_NAME=Client Legal Name Pvt Ltd

# Postgres — pick a real password, not the dev default.
POSTGRES_IMAGE=postgres:15@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_DB=vansales
POSTGRES_USER=vansales
POSTGRES_PASSWORD=change-me-a-real-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery
REDIS_IMAGE=redis:7@sha256:REPLACE_WITH_VERIFIED_DIGEST
REDIS_URL=redis://redis:6379/0

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=14

# Field-level encryption key for stored ERP connector credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# Connector agent (on-prem Tally connector authenticates with this key)
CONNECTOR_API_KEY=change-me-connector-key

# Admin web — the API's public domain (baked into the admin-web build,
# see admin-web/Dockerfile.prod).
NEXT_PUBLIC_API_BASE_URL=https://api.fieldopspro.in
NGINX_IMAGE=nginx:1.27-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
CERTBOT_IMAGE=certbot/certbot@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Auth-cookie domain scope: ".fieldopspro.in" makes one login work
# across the apex, www, and app hosts (all serve the same console).
# Leave blank for host-only cookies (each host = its own session).
AUTH_COOKIE_DOMAIN=.fieldopspro.in

# Connector agent requests must be HMAC-signed (replay protection).
# Only set this to 1 temporarily if an already-deployed agent binary
# predates signing — never for a fresh deployment.
CONNECTOR_ALLOW_UNSIGNED=0

# ---- Optional, add once you have them ----
# Error tracking (config/settings/production.py wires this up automatically
# if set; leave blank to skip Sentry entirely).
SENTRY_DSN=

# Outbound email for "emailable" reports (AR-02/FM-13). Without this set,
# email is logged to the container's console instead of actually sent —
# safe to leave blank until a real SMTP account exists.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=reports@fieldopspro.in

# Push notifications (FR-18) / SMS gateway (FR-12 OTP) — same pattern:
# blank means console-logged, not a fake "sent" result.
FCM_SERVER_KEY=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# NOT needed for a single-client deployment — this activates the
# subdomain-per-tenant routing in apps.tenancy (see its middleware
# docstring). Leave unset unless you deliberately move to the
# multi-tenant SaaS model later.
# PLATFORM_ROOT_DOMAINS=
